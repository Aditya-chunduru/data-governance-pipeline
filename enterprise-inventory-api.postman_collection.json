{
  "info": {
    "_postman_id": "7e317aca-5290-48ba-86bb-d62ac411bb1a",
    "name": "enterprise-inventory-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56012449"
  },
  "item": [
    {
      "name": "Get Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Wrap parsing in a try block to prevent CI/CD runner crashes if the server returns non-JSON or gateway error pages",
              "try {",
                 
              "// Convert the raw HTTP response body into a structured JavaScript object",
              
              "    const responseJson = pm.response.json();",
              "    ",
              
              " // Validate response code and verify token existence before caching",
              "    if (pm.response.code === 200 && responseJson.access_token) {",
              "        pm.environment.set(\"jwt_token\", responseJson.access_token);",
              "        ",
              
              "        // Calculate absolute token expiration timestamp if provided",
              "        if (responseJson.expires_in) {",
              "            const currentTime = Math.floor(Date.now() / 1000);",
              "            pm.environment.set(\"token_expiry\", currentTime + responseJson.expires_in);",
              "        }",
              "        ",
              "        console.log(\"Auth success: JWT token and expiration cached.\");",
              "    } else {",
              "        console.error(\"Auth failed: Response missing access token or invalid status code.\");",
              "    }",
              "",
              
              " // Assert successful HTTP status",
              "    pm.test(\"Auth status is 200\", () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "} catch (e) {",
              "    console.error(\"Could not parse auth response as JSON.\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supa_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{user_jwt}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{user_email}}\",\n    \"password\": \"{{user_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{supa_url}}/auth/v1/token?grant_type=password",
          "host": ["{{supa_url}}"],
          "path": ["auth", "v1", "token"],
          "query": [{ "key": "grant_type", "value": "password" }]
        }
      },
      "response": []
    },
    {
      "name": "Business Endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [

              "// Wrap parsing and recursive masking in a try block to prevent runner crashes on unexpected non-JSON responses",
              "try {",
              
              "// Parse the incoming HTTP response body into a structured JavaScript object",
              "    const responseJson = pm.response.json();",
              
              "    ",
              "// Define sensitive identifiers that must be scrubbed for build log hygiene",
              "    const targetFields = [\"user_id\", \"profiles_id\", \"id\"];",
              
              "    ",
              "// Define a recursive helper function to walk through nested objects and arrays",
              "    function sanitize(obj) {",
              
              "       // Base case: return primitives or null/undefined as-is",
              "        if (!obj || typeof obj !== \"object\") return obj;",
              
              "        // If it's an array, process each item recursively",
              "        if (Array.isArray(obj)) return obj.map(item => sanitize(item));",
              "        ",
              "        // Create a clean clone to avoid mutating the original response reference",
              "        let clone = {};",
              "        for (let key of Object.keys(obj)) {",
              "            // Check if the key matches a sensitive target field case-insensitively",
              "            if (targetFields.includes(key.toLowerCase())) {",
              "                clone[key] = \"[MASKED]\";",
              "            } else {",
              "                // Recursively traverse nested object properties",
              "                clone[key] = sanitize(obj[key]);",
              "            }",
              "        }",
              "        return clone;",
              "    }",
              "",
              "    // Execute sanitization across the entire response payload tree",
              "    const cleanOutput = sanitize(responseJson);",
              "    ",
              "    // Output the clean, redacted preview to the CI/CD console logs safely",
              "    console.log(\"=== SANITIZED RESPONSE PREVIEW ===\");",
              "    console.log(JSON.stringify(cleanOutput, null, 2));",
              "",
              "    // Assert standard HTTP success for the business endpoint",
              "    pm.test(\"Response status is 200\", () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "} catch (e) {",
              "    // Fallback error catcher if response body cannot be parsed as JSON",
              "    console.log(\"Could not parse response as JSON for masking.\");",
              "}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": { "disableBodyPruning": true },
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{supa_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": { "mode": "raw", "raw": "" },
        "url": {
          "raw": "{{supa_url}}/rest/v1/orders",
          "host": ["{{supa_url}}"],
          "path": ["rest", "v1", "orders"]
        }
      },
      "response": []
    }
  ]
}
