{
  "info": {
    "_postman_id": "7e317aca-5290-48ba-86bb-d62ac411bb1a",
    "name": "enterprise-inventory-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56012449"
  },
  "item": [
    {
      "name": "Get Auth Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "    const responseJson = pm.response.json();",
              "    ",
              "    if (pm.response.code === 200 && responseJson.access_token) {",
              "        pm.environment.set(\"jwt_token\", responseJson.access_token);",
              "        ",
              "        if (responseJson.expires_in) {",
              "            const currentTime = Math.floor(Date.now() / 1000);",
              "            pm.environment.set(\"token_expiry\", currentTime + responseJson.expires_in);",
              "        }",
              "        ",
              "        console.log(\"Auth success: JWT token and expiration cached.\");",
              "    } else {",
              "        console.error(\"Auth failed: Response missing access token or invalid status code.\");",
              "    }",
              "",
              "    pm.test(\"Auth status is 200\", () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "} catch (e) {",
              "    console.error(\"Could not parse auth response as JSON.\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{supa_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{user_jwt}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{user_email}}\",\n    \"password\": \"{{user_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{supa_url}}/auth/v1/token?grant_type=password",
          "host": ["{{supa_url}}"],
          "path": ["auth", "v1", "token"],
          "query": [{ "key": "grant_type", "value": "password" }]
        }
      },
      "response": []
    },
    {
      "name": "Business Endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "    const responseJson = pm.response.json();",
              "    ",
              "    const targetFields = [\"user_id\", \"profiles_id\", \"id\"];",
              "    ",
              "    function sanitize(obj) {",
              "        if (!obj || typeof obj !== \"object\") return obj;",
              "        if (Array.isArray(obj)) return obj.map(item => sanitize(item));",
              "        ",
              "        let clone = {};",
              "        for (let key of Object.keys(obj)) {",
              "            if (targetFields.includes(key.toLowerCase())) {",
              "                clone[key] = \"[MASKED]\";",
              "            } else {",
              "                clone[key] = sanitize(obj[key]);",
              "            }",
              "        }",
              "        return clone;",
              "    }",
              "",
              "    const cleanOutput = sanitize(responseJson);",
              "    ",
              "    console.log(\"=== SANITIZED RESPONSE PREVIEW ===\");",
              "    console.log(JSON.stringify(cleanOutput, null, 2));",
              "",
              "    pm.test(\"Response status is 200\", () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "} catch (e) {",
              "    console.log(\"Could not parse response as JSON for masking.\");",
              "}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": { "disableBodyPruning": true },
      "request": {
        "method": "GET",
        "header": [
          { "key": "apikey", "value": "{{supa_anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Prefer", "value": "return=representation" }
        ],
        "body": { "mode": "raw", "raw": "" },
        "url": {
          "raw": "{{supa_url}}/rest/v1/orders",
          "host": ["{{supa_url}}"],
          "path": ["rest", "v1", "orders"]
        }
      },
      "response": []
    }
  ]
}
